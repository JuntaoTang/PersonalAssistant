# Copy to this directory as .env. Never send passwords in chat or commit this file.
# Workspace ../../.env is also read; its existing bare DeepSeek key is supported.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=

FEISHU_APP_ID=
FEISHU_APP_SECRET=

MAIL_USERNAME=yourname@smail.nju.edu.cn
MAIL_IMAP_HOST=imap.exmail.qq.com
MAIL_IMAP_PORT=993
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
# Keep disabled until the user confirms which messages may be read.
MAIL_ENABLED=false
MAIL_SCOPE=
MAIL_POLL_SECONDS=300

# Final submission is not implemented in this version.
FORM_SUBMIT_ENABLED=false
